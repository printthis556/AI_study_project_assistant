{
  "name": "Qt C++ Development",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup-qt.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "cmake.configureOnOpen": false
      }
    }
  },

  "forwardPorts": [],
  
  "remoteUser": "vscode"
}
